<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>org.sanmibuh.tedee</groupId>
  <artifactId>tedee-automation</artifactId>
  <version>0.3.5-SNAPSHOT</version>
  <name>tedee-automation</name>
  <description>Tedee smart lock automation backend</description>

  <properties>
    <archunit.version>1.5.1</archunit.version>
    <error-prone.version>2.51.0</error-prone.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <hibernate-query-asserts.version>2.2.0</hibernate-query-asserts.version>
    <liquibase.version>5.0.4</liquibase.version>
    <jacoco.version>0.8.15</jacoco.version>
    <logcaptor.version>2.13.0</logcaptor.version>
    <java.version>25</java.version>
    <nullaway.version>0.14.2</nullaway.version>
    <test.spring.config.location>classpath:/</test.spring.config.location>
    <test.db.url>jdbc:h2:mem:tedee</test.db.url>
    <openapi-generator.version>7.26.0</openapi-generator.version>
    <pitest-history-plugin.version>0.0.1</pitest-history-plugin.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <pitest.version>1.30.1</pitest.version>
    <spotless.version>3.10.4</spotless.version>
    <tedee.client.package>com.tedee.bridge.client</tedee.client.package>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>

    <!-- Persistence: JPA on file-based H2 (pure Java, native-image friendly); schema DDL is owned by Liquibase (run from a separate image) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Generated Tedee Bridge API client (openapi-generator, java/restclient) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.12</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mickaelb</groupId>
      <artifactId>hibernate-query-asserts</artifactId>
      <version>${hibernate-query-asserts.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.hakky54</groupId>
      <artifactId>logcaptor</artifactId>
      <version>${logcaptor.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <!-- The Liquibase changelog is the schema source of truth; tests apply it from the classpath. -->
        <directory>db/changelog</directory>
        <targetPath>db/changelog</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <!-- Isolate tests from the git-ignored ./config/application.yml so local runs match CI. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.config.location>${test.spring.config.location}</spring.config.location>
            <test.db.url>${test.db.url}</test.db.url>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/generated-sources/.* -Xep:NullAway:ERROR
              -XepOpt:NullAway:AnnotatedPackages=org.sanmibuh -XepOpt:NullAway:AcknowledgeRestrictiveAnnotations=true
            </arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-tedee-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/openapi/tedee-bridge-api.json</inputSpec>
              <generatorName>java</generatorName>
              <library>restclient</library>
              <apiPackage>${tedee.client.package}.api</apiPackage>
              <modelPackage>${tedee.client.package}.model</modelPackage>
              <invokerPackage>${tedee.client.package}</invokerPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <!-- Remove once OpenAPI Generator supports Jackson 3 with the java8 date library. -->
                <dateLibrary>legacy</dateLibrary>
                <useJakartaEe>true</useJakartaEe>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <openApiNullable>false</openApiNullable>
                <useJackson3>true</useJackson3>
                <useBeanValidation>false</useBeanValidation>
                <useSpringBoot4>true</useSpringBoot4>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <includes>
            <include>org/sanmibuh/**</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5-plugin.version}</version>
          </dependency>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-history-plugin</artifactId>
            <version>${pitest-history-plugin.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>org.sanmibuh.*</param>
          </targetClasses>
          <targetTests>
            <param>org.sanmibuh.*</param>
          </targetTests>
          <excludedMethods>
            <excludedMethod>*PITEquivalent</excludedMethod>
          </excludedMethods>
          <jvmArgs>
            <jvmArg>-Dspring.config.location=${test.spring.config.location}</jvmArg>
          </jvmArgs>
          <timestampedReports>false</timestampedReports>
          <historyInputFile>${project.basedir}/.pit/history-input.bin</historyInputFile>
          <historyOutputFile>${project.basedir}/.pit/history-output.bin</historyOutputFile>
          <outputFormats>
            <outputFormat>XML</outputFormat>
            <outputFormat>HTML</outputFormat>
          </outputFormats>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs>
                <buildArg>--static</buildArg>
                <buildArg>--libc=musl</buildArg>
                <buildArg>-march=x86-64-v2</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Development aid for the local database: `make execute-migration` applies the changelog (liquibase:update)
           and `make create-migration` (scripts/generate-migration.sh) diffs the JPA entities, read directly
           by liquibase-hibernate7, against it. The plugin classpath lists what that extension needs. -->
      <id>migration</id>
      <properties>
        <migration.dir>${project.build.directory}/migration</migration.dir>
        <!-- Local development database (without the .mv.db suffix); make passes DB_DIR through -Ddb.path. -->
        <db.path>${project.basedir}/data/tedee</db.path>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-maven-plugin</artifactId>
            <version>${liquibase.version}</version>
            <dependencies>
              <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
              </dependency>
              <dependency>
                <groupId>org.liquibase.ext</groupId>
                <artifactId>liquibase-hibernate7</artifactId>
                <version>${liquibase.version}</version>
              </dependency>
              <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-orm</artifactId>
                <version>${spring-framework.version}</version>
              </dependency>
              <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.version}</version>
              </dependency>
              <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-hibernate</artifactId>
                <version>${project.parent.version}</version>
              </dependency>
              <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta-validation.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <searchPath>${project.basedir}</searchPath>
              <changeLogFile>db/changelog/db.changelog-master.yaml</changeLogFile>
              <url>jdbc:h2:file:${db.path}</url>
              <referenceUrl>hibernate:spring:org.sanmibuh.tedee?dialect=org.hibernate.dialect.H2Dialect&amp;hibernate.implicit_naming_strategy=org.sanmibuh.framework.persistence.JpaEntityImplicitNamingStrategy&amp;hibernate.physical_naming_strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategySnakeCaseImpl</referenceUrl>
              <diffChangeLogFile>${migration.dir}/out/${migration.name}.h2.sql</diffChangeLogFile>
            </configuration>
            <executions>
              <execution>
                <id>diff-against-entities</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>diff</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
